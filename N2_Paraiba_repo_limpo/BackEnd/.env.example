# Obrigatorio para extrair dados com Gemini
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI
GEMINI_MODEL=gemini-3.5-flash-lite

# Banco local: SQLite. Na hospedagem, substitua pela URL do PostgreSQL.
DATABASE_URL=sqlite:///./administrativo.db

# Credenciais SOMENTE para desenvolvimento local; altere no servidor.
APP_LOGIN=admin
APP_PASSWORD=admin123
APP_SECRET_KEY=chave-local-de-exemplo-altere-antes-de-hospedar
